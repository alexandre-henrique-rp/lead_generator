# ==========================================================================
# lead_generator — .env.example
# --------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# ==========================================================================

# Database URL for SQLite (Prisma 7 + better-sqlite3)
DATABASE_URL="file:./dev.db"

# ==========================================================================
# CHAVES DE API — NÃO PRECISAM MAIS FICAR AQUI
# --------------------------------------------------------------------------
# As chaves de provedores externos (AIsa, Google Maps, Gemini, OpenRouter,
# SMTP) ficam salvas no BANCO (model ConfiguracaoIntegracao, singleton id=1)
# e são gerenciadas em Configurações → Integrações (rota /configuracoes).
#
# O servidor resolve a chave efetiva assim:
#   1. banco (Configurações → Integrações)  ← tem precedência
#   2. process.env abaixo                    ← fallback apenas na migração
#
# Os valores abaixo são OPCIONAIS e servem só de fallback enquanto a tela de
# Integrações não for preenchida. Recomendado: deixar vazio e cadastrar pela
# tela (a chave nunca é exibida em claro, só mascarada).
# ==========================================================================

# AIsa Gateway (Apollo B2B) — opcional (fallback)
AISA_API_KEY=""

# Google Maps Places (direto) — opcional (fallback)
GOOGLE_MAPS_API_KEY=""

# Google Gemini — opcional (fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# API de CNPJ (BrasilAPI é pública, sem chave — basta deixar como abaixo).
# Para usar ReceitaWS, CNPJ.ws ou similar (paga), troque o valor:
#   CNPJ_API_URL=https://www.receitaws.com.br/v1
CNPJ_API_URL="https://brasilapi.com.br/api/cnpj/v1"
