# ==========================================================================
# lead_generator — .env.example
# --------------------------------------------------------------------------
# Espelha as variáveis do docker-compose.yml (os valores são os defaults do
# compose, exceto onde indicado "DEV").
#   • Dev local: copie para .env.local e preencha. NUNCA commite o .env.local.
#   • Docker/Coolify: defina no painel; o que não for definido usa o default
#     do compose (${VAR:-default}).
# ==========================================================================

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV="production"   # DEV: "development"
PORT="3000"

# ── Banco SQLite ──────────────────────────────────────────────────────────
# Docker: caminho absoluto no volume "sisten_data" montado em /data.
# DEV: use DATABASE_URL="file:./dev.db"
DATABASE_URL="file:/data/prod.db"
# Diretório criado pelo docker-entrypoint.sh (mesmo ponto de montagem do volume)
DB_DATA_DIR="/data"

# ── Admin (seed na 1ª inicialização, só roda com o banco vazio) ───────────
# TROQUE ADMIN_SENHA antes do 1º deploy!
ADMIN_EMAIL="admin@kingdevtec.com"
ADMIN_SENHA="troque-em-producao"
ADMIN_NOME="Administrador KingDevTec"

# ── URL pública ───────────────────────────────────────────────────────────
SERVER_URL="https://kingdevtec.com"
VITE_APP_TITLE="KingDevTec — Sisten"

# ── API de CNPJ ───────────────────────────────────────────────────────────
# BrasilAPI é pública, sem chave. Para ReceitaWS, CNPJ.ws etc., troque o valor:
#   CNPJ_API_URL=https://www.receitaws.com.br/v1
CNPJ_API_URL="https://brasilapi.com.br/api/cnpj/v1"

# ==========================================================================
# CHAVES DE API — OPCIONAIS (fallback)
# --------------------------------------------------------------------------
# As chaves ficam salvas no BANCO (model ConfiguracaoIntegracao, singleton
# id=1) e são gerenciadas em Configurações → Integrações (/configuracoes).
# O servidor resolve assim:
#   1. banco (Configurações → Integrações)  ← tem precedência
#   2. process.env abaixo                    ← fallback apenas na migração
# Recomendado: deixar vazio e cadastrar pela tela.
# ==========================================================================
AISA_API_KEY=""
GOOGLE_MAPS_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ==========================================================================
# Lidas pelo código, mas NÃO repassadas pelo docker-compose.yml
# --------------------------------------------------------------------------
# Para usar no Docker, adicione-as em `environment:` do compose.
# ==========================================================================
# OPENROUTER_API_KEY=""            # fallback da integração OpenRouter
# GEMINI_PAID_FALLBACK="false"     # "true" permite cair em modelo pago
# LEAD_GENERATOR_CSV_PATH=""       # caminho do CSV de importação de leads
