# ==========================================================================
# .env.coolify — Variáveis de ambiente para o Coolify
# --------------------------------------------------------------------------
# Cole estes valores no painel do Coolify em:
#   Application → Environment Variables
#
# NÃO commite este arquivo com valores reais preenchidos.
# ==========================================================================

# ── Banco de dados SQLite ──────────────────────────────────────────────────
#
# IMPORTANTE: o banco fica dentro do volume Docker montado em /data.
# Formato OBRIGATÓRIO: file:<caminho-absoluto> (NÃO use file:./ em produção)
#
# No Coolify, configure também em:
#   Application → Storage → Add Volume
#     Source (host path ou volume nomeado): sisten_data
#     Destination (container path):        /data
#
DATABASE_URL=file:/data/prod.db

# Diretório do volume (usado pelo entrypoint para garantir que existe)
DB_DATA_DIR=/data

# ── Credenciais do administrador ──────────────────────────────────────────
# OBRIGATÓRIO: troque ADMIN_SENHA antes de fazer o primeiro deploy!
ADMIN_EMAIL=admin@kingdevtec.com
ADMIN_SENHA=troque-em-producao
ADMIN_NOME=Administrador KingDevTec

# ── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── API de CNPJ (público, sem chave necessária) ────────────────────────────
CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1

# ── URL pública da aplicação ──────────────────────────────────────────────
SERVER_URL=https://kingdevtec.com
VITE_APP_TITLE=KingDevTec — Sisten

# ── Integrações externas (OPCIONAIS) ──────────────────────────────────────
# Deixe vazio — configure depois em Configurações → Integrações no sistema
AISA_API_KEY=
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
